{
  "name": "blockhost-manager",
  "productName": "BlockHost Manager",
  "version": "1.0.0",
  "description": "Minecraft server hosting management for local server.jar instances",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "build:hardware-monitor": "dotnet publish native/hardware-monitor-helper/HardwareMonitorHelper.csproj -c Release -r win-x64 --self-contained true -o resources/hardware-monitor --source https://api.nuget.org/v3/index.json",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": "nadit",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "42.4.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
